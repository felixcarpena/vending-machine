{
    "name": "felixcarpena/vending-machine",
    "description": "A vending machine that takes coins, sells products and gives change.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "behat/behat": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Vending\\": "src/Vending/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
